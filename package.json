{
  "name": "narenana-website",
  "version": "0.3.0",
  "private": true,
  "description": "narenana.com — Cloudflare Worker with static assets, routing, and YouTube feed cache",
  "scripts": {
    "dev": "wrangler dev",
    "dev:static": "npx serve site -l 3000",
    "aircraft:build": "node scripts/build-aircraft-social-card.mjs && node scripts/build-nanawing-pages.mjs && node scripts/build-aircraft-social-card.mjs content/nanawing/chupito-simulator.json && node scripts/build-nanawing-landing.mjs content/nanawing/chupito-simulator.json",
    "aircraft:test": "node --test scripts/nanawing-aircraft.test.mjs scripts/nanawing-landing.test.mjs",
    "landing:images": "node scripts/build-landing-images.mjs content/nanawing/chupito-simulator.json",
    "landing:prints": "node scripts/fetch-print-images.mjs content/nanawing/chupito-simulator.json",
    "landing:audit": "node scripts/landing-audit.mjs content/nanawing/chupito-simulator.json",
    "assets": "node scripts/gen-assets.mjs && node scripts/version-assets.mjs",
    "deploy": "wrangler deploy",
    "catalog:css": "node catalog/lib/gen-styles.mjs",
    "catalog:migrate": "wrangler d1 migrations apply CATALOG_DB --local",
    "catalog:migrate:remote": "wrangler d1 migrations apply CATALOG_DB --remote",
    "catalog:test": "node --test catalog/test/suite.mjs",
    "seo:test": "node --test catalog/test/seo.mjs catalog/test/prints-live.mjs",
    "curator:test": "node --test catalog/test/curator.mjs catalog/test/curator-dedup.mjs",
    "seo:audit": "node scripts/sitemap-audit.mjs && node scripts/seo-audit.mjs --local && node scripts/release-link-audit.mjs",
    "sitemap:audit": "node scripts/sitemap-audit.mjs",
    "assets:version": "node scripts/version-assets.mjs",
    "assets:check": "node scripts/version-assets.mjs --check"
  },
  "devDependencies": {
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "wrangler": "^4.111.0"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.1.0"
  }
}
